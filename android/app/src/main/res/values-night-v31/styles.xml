<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Pre-splash de Android 12 o superior: fondo sólido y la casita como icono. -->
    <style name="LaunchTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/nido_splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_house</item>
        <item name="android:windowSplashScreenAnimationDuration">300</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
